    "*Thorn tries to attack Carlo Venchinni.*"

# game/cenas/dia3/cena34.rpy:55
translate english CENA34_6796a8ea:

    # vnc "Vira-lata imundo. Matem-no."
    vnc "Filthy mutt. Kill it."

